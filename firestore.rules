rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── FUNCIONES DE AYUDA ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Obtiene el idEmpresa del usuario autenticado leyendo su perfil
    function getUserEmpresa() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.idEmpresa;
    }

    // Verifica si el documento existente pertenece a la misma empresa del usuario
    function isSameEmpresa() {
      return resource == null || resource.data.idEmpresa == getUserEmpresa();
    }

    // Verifica si el nuevo documento que se intenta crear pertenece a la misma empresa del usuario
    function isCreatingForSameEmpresa() {
      return request.resource.data.idEmpresa == getUserEmpresa();
    }

    // Verifica si el usuario es administrador
    function isCompanyAdmin() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'ADMIN';
    }

    // Verifica si el usuario es SUPER_ADMIN / Maestro de la plataforma
    function isSuperAdmin() {
      let userData = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return request.auth.token.isSuperAdmin == true ||
             userData.rol == 'SUPER_ADMIN' || 
             userData.isSuperAdmin == true || 
             (userData.rol == 'ADMIN' && (
               request.auth.token.email == 'cristian.inostroza@gmail.com' ||
               request.auth.token.email == 'tte.inostroza@gmail.com' ||
               request.auth.token.email == 'admin@heirlog.cl' ||
               request.auth.token.email == 'contacto@heirlog.cl' ||
               userData.idEmpresa == 'heirlog'
             ));
    }

    // Verifica si el usuario es dueño del documento (asumiendo campo idChofer)
    function isOwner() {
      return resource.data.idChofer == request.auth.uid;
    }

    // Valida que no se estén alterando campos protegidos (rol e idEmpresa)
    function isNotAlteringProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'idEmpresa']);
    }

    // ─── REGLAS POR COLECCIÓN ────────────────────────────────────────────────

    // 1. Usuarios
    match /usuarios/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || resource.data.idEmpresa == getUserEmpresa());
      // Solo el propio usuario o un ADMIN pueden escribir, pero NADIE puede cambiarse el rol/empresa a sí mismo (excepto ADMIN de su propia empresa)
      allow write: if isAuthenticated() && (
        (request.auth.uid == userId && isNotAlteringProtectedFields()) || 
        (isSameEmpresa() && isCompanyAdmin())
      );
    }

    // 2. Empresas
    match /empresas/{empresaId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
      allow update: if isAuthenticated() && getUserEmpresa() == empresaId && isCompanyAdmin();
    }

    // 3. Invitaciones
    match /invitaciones/{invitacionId} {
      // Solo admins pueden crear invitaciones
      allow create: if isAuthenticated() && isCompanyAdmin();
      // Solo el destinatario (por email) o el admin de la empresa pueden leer
      allow read: if isAuthenticated() && (request.auth.token.email == resource.data.email || isSameEmpresa());
      // Solo el admin puede borrar o modificar
      allow update, delete: if isAuthenticated() && isSameEmpresa() && isCompanyAdmin();
    }

    // 4. Configuración de Empresa
    match /configuraciones_empresa/{empresaId} {
      allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
      allow write: if isAuthenticated() && getUserEmpresa() == empresaId && isCompanyAdmin();
    }

    match /config_empresas/{empresaId} {
      allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
      allow write: if isAuthenticated() && getUserEmpresa() == empresaId && isCompanyAdmin();
    }

    // 5. Colecciones Multi-Tenant Rigurosas
    // Aplica a: jornadas, viajes, gastos, vehiculos, viaticos, liquidaciones
    
    match /jornadas/{docId} {
      allow read: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
      // Solo el dueño o el admin pueden actualizar/borrar
      allow update, delete: if isAuthenticated() && isSameEmpresa() && (isOwner() || isCompanyAdmin());
    }

    match /viajes/{docId} {
      allow read: if isAuthenticated() && isSameEmpresa();
      // Choferes y administradores pueden crear viajes con su valor inicial correspondiente
      allow create: if isAuthenticated() && isCreatingForSameEmpresa() 
                    && request.resource.data.value is number;
      // Admins pueden actualizar cualquier campo. Choferes (isOwner) NO pueden corregir ni alterar valores financieros
      allow update: if isAuthenticated() && isSameEmpresa() && (
        isCompanyAdmin() || 
        (isOwner() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['value', 'extraCostos', 'sobreEstadia', 'idEmpresa', 'billingType', 'comision']))
      );
      // Solo administradores pueden eliminar un viaje (evita borrado fraudulento)
      allow delete: if isAuthenticated() && isSameEmpresa() && isCompanyAdmin();
    }

    match /gastos/{docId} {
      allow read: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa()
                    && request.resource.data.amount is number;
      allow update, delete: if isAuthenticated() && isSameEmpresa() && (isOwner() || isCompanyAdmin());
    }

    match /vehiculos/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    match /viaticos/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    match /liquidaciones/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    match /incidencias/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    match /cotizaciones/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    match /contadores/{docId} {
      allow read, update, delete: if isAuthenticated() && isSameEmpresa();
      allow create: if isAuthenticated() && isCreatingForSameEmpresa();
    }

    // 6. Secretos (Solo lectura para SuperAdmin o Admin de la propia empresa)
    match /secrets/{docId} {
      allow read: if isAuthenticated() && (isSuperAdmin() || (isCompanyAdmin() && docId == getUserEmpresa()));
      allow write: if false; // Nadie escribe desde la app
    }
    // 7. Solicitudes de Servicio (IA) - Aislado por empresa
    match /service_requests/{docId} {
      allow read, write: if isAuthenticated() && isSameEmpresa();
    }

    // 8. Telemetría GPS (raw_positions, events, trip_summaries)
    // El documento padre es el idEmpresa; las subcolecciones contienen los datos.
    match /telemetry/{empresaId} {
      allow read, write: if isAuthenticated() && getUserEmpresa() == empresaId;

      match /raw_positions/{docId} {
        allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
        allow create, update: if isAuthenticated() && getUserEmpresa() == empresaId;
      }

      match /events/{docId} {
        allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
        allow create, update: if isAuthenticated() && getUserEmpresa() == empresaId;
      }

      match /trip_summaries/{docId} {
        allow read: if isAuthenticated() && getUserEmpresa() == empresaId;
        allow create, update: if isAuthenticated() && getUserEmpresa() == empresaId;
        // Solo admin puede borrar resúmenes históricos
        allow delete: if isAuthenticated() && getUserEmpresa() == empresaId && isCompanyAdmin();
      }
    }

    // 9. Infraestructura Vial Universal (Peajes, Romanas, Restricciones)
    // Lectura global para cualquier usuario autenticado de la plataforma
    // Creación, edición y borrado exclusivo para el Usuario Maestro (SuperAdmin)
    match /infraestructura_vial/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isSuperAdmin();
    }

    // 10. Buzón de Reportes Colaborativos de Ruta (Crowdsourcing)
    // Choferes y administradores pueden reportar eventos con estado 'pendiente'
    // Solo el SuperAdmin puede moderar, aprobar o descartar
    match /reportes_infraestructura/{docId} {
      allow read: if isAuthenticated() && (isSameEmpresa() || isSuperAdmin());
      allow create: if isAuthenticated() && request.resource.data.estado == 'pendiente';
      allow update, delete: if isAuthenticated() && isSuperAdmin();
    }

    // 11. Control de Versiones y Actualización en Línea (OTA)
    // Lectura pública/abierta para que la app siempre pueda verificar si hay una nueva versión
    // Escritura restringida exclusivamente al SuperAdmin
    match /app_version/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && isSuperAdmin();
    }
  }
}
